{
  "name": "@orbitdb/core-types",
  "version": "1.2.4",
  "description": "Official typings for OrbitDB",
  "types": "src/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbitdb/core-types.git"
  },
  "keywords": [
    "@types",
    "typescript",
    "orbit-db"
  ],
  "author": "lukas2005; Julien Jean Malard-Adam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orbitdb/core-types/issues"
  },
  "homepage": "https://github.com/orbitdb/core-types#readme",
  "scripts": {
    "test": "pnpm tsc -p tsconfig.json",
    "format": "pnpm prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\" && pnpm eslint . --fix",
    "release": "pnpm test && pnpm format && pnpm publish --access public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/events": "^3.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@helia/libp2p": "^2.1.4",
    "@libp2p/interface": "^3.3.0",
    "multiformats": "^14.0.5",
    "tiny-typed-emitter": "^2.1.0"
  }
}
